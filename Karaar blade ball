--========================================
-- BUTTON COLORS
--========================================

local function UpdateButton(Button, Enabled, Name)

    Button.Text = Name .. (Enabled and ": ON" or ": OFF")

    Button.BackgroundColor3 = Enabled
        and Color3.fromRGB(105, 55, 190)
        or Color3.fromRGB(43, 43, 58)
end

