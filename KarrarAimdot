-- Player Tracking System
-- Roblox Studio - LocalScript

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local TrackingEnabled = false
local Target = nil

local Smoothness = 0.12
local MaxDistance = 300

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TrackingUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local Button = Instance.new("TextButton")
Button.Size = UDim2.fromOffset(150, 45)
Button.Position = UDim2.new(0.5, -75, 0.85, 0)
Button.Text = "Tracking: OFF"
Button.TextScaled = true
Button.Parent = ScreenGui

local function GetClosestPlayer()

    local Closest = nil
    local ShortestDistance = MaxDistance

    for _, Player in ipairs(Players:GetPlayers()) do

        if Player ~= LocalPlayer then

            local Character = Player.Character
            local Head = Character and Character:FindFirstChild("Head")
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

            if Head and Humanoid and Humanoid.Health > 0 then

                local Distance =
                    (Camera.CFrame.Position - Head.Position).Magnitude

                if Distance < ShortestDistance then
                    ShortestDistance = Distance
                    Closest = Head
                end

            end
        end
    end

    return Closest
end

Button.Activated:Connect(function()

    TrackingEnabled = not TrackingEnabled

    Button.Text = TrackingEnabled
        and "Tracking: ON"
        or "Tracking: OFF"

    if not TrackingEnabled then
        Target = nil
    end

end)

RunService.RenderStepped:Connect(function()

    if not TrackingEnabled then
        return
    end

    if not Target or not Target.Parent then
        Target = GetClosestPlayer()
    end

    if Target then

        local CurrentPosition = Camera.CFrame.Position
        local TargetPosition = Target.Position

        local DesiredCFrame = CFrame.lookAt(
            CurrentPosition,
            TargetPosition
        )

        Camera.CFrame = Camera.CFrame:Lerp(
            DesiredCFrame,
            Smoothness
        )

    end

end)
