-- ═══════════════════════════════════════════
-- ⚙️ الإعدادات
-- ═══════════════════════════════════════════
local CONFIG = {
    -- إعدادات التصويب
    FOV_RADIUS = 150,
    AIM_SMOOTHNESS = 0.35,
    STICKINESS = 0.85,
    MAX_DISTANCE = 500,
    HEAD_OFFSET = Vector3.new(0, 0, 0),
    AIM_KEY = Enum.KeyCode.Q,
    
    -- إعدادات ESP
    ESP_KEY = Enum.KeyCode.E,
    ESP_MAX_DISTANCE = 1000,
    ESP_SHOW_HEALTH = true,
    ESP_SHOW_NAME = true,
    ESP_SHOW_DISTANCE = true,
    ESP_BOX_COLOR = Color3.fromRGB(255, 50, 50),
    ESP_TEXT_COLOR = Color3.fromRGB(255, 255, 255),
    ESP_HEALTH_COLOR = Color3.fromRGB(0, 255, 0),
}

-- ═══════════════════════════════════════════
-- 📦 المتغيرات
-- ═══════════════════════════════════════════
local currentTarget = nil
local isAiming = false
local isESPEnabled = false
local espObjects = {}  -- تخزين كائنات ESP لكل لاعب

-- ═══════════════════════════════════════════
-- 🛠️ دوال التصويب
-- ═══════════════════════════════════════════

local function HasLineOfSight(targetHead)
    local origin = Camera.CFrame.Position
    local direction = targetHead.Position - origin
    local distance = direction.Magnitude
    
    if distance > CONFIG.MAX_DISTANCE then return false, distance end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local result = workspace:Raycast(origin, direction, params)
    
    if not result then return true, distance end
    if result.Instance and result.Instance:IsDescendantOf(targetHead.Parent) then
        return true, distance
    end
    return false, distance
end

local function GetScreenDistance(targetHead)
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
    if not onScreen then return math.huge end
    
    local mousePos = UserInputService:GetMouseLocation()
    return (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if LocalPlayer.Team and player.Team then
        if LocalPlayer.Team == player.Team then return false end
    end
    return true
end

local function IsValidTarget(player)
    if not IsEnemy(player) then return false end
    local char = player.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    return true, head
end

local function FindBestTarget()
    local bestTarget = nil
    local bestScore = math.huge
    
    if currentTarget then
        local valid, head = IsValidTarget(currentTarget)
        if valid then
            local screenDist = GetScreenDistance(head)
            local hasLOS = HasLineOfSight(head)
            if hasLOS and screenDist < CONFIG.FOV_RADIUS then
                bestTarget = currentTarget
                bestScore = screenDist * (1 - CONFIG.STICKINESS)
            end
        else
            currentTarget = nil
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == currentTarget then continue end
        local valid, head = IsValidTarget(player)
        if not valid then continue end
        local screenDist = GetScreenDistance(head)
        if screenDist > CONFIG.FOV_RADIUS then continue end
        local hasLOS, worldDist = HasLineOfSight(head)
        if not hasLOS then continue end
        local score = screenDist + (worldDist * 0.05)
        if score < bestScore then
            bestScore = score
            bestTarget = player
        end
    end
    
    currentTarget = bestTarget
    return currentTarget
end

-- ═══════════════════════════════════════════
-- 👁️ دوال ESP
-- ═══════════════════════════════════════════

-- إنشاء ESP للاعب معين
local function CreateESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end
    
    local esp = {}
    
    -- 🔹 Box Highlight (يظهر عبر الجدران)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = CONFIG.ESP_BOX_COLOR
    highlight.FillTransparency = 0.7
    highlight.OutlineColor = CONFIG.ESP_BOX_COLOR
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = player.Character
    highlight.Parent = player.Character
    
    esp.Highlight = highlight
    
    -- 🔹 BillboardGui (الاسم + الصحة + المسافة فوق الرأس)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = CONFIG.ESP_MAX_DISTANCE
    billboard.Parent = player.Character:FindFirstChild("Head") or player.Character
    
    -- إطار خلفي
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 0
    frame.Parent = billboard
    
    local frameCorner = Instance.new("UICorner")
    frameCorner.CornerRadius = UDim.new(0, 8)
    frameCorner.Parent = frame
    
    -- اسم اللاعب
    if CONFIG.ESP_SHOW_NAME then
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "NameLabel"
        nameLabel.Size = UDim2.new(1, 0, 0.4, 0)
        nameLabel.Position = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3 = CONFIG.ESP_TEXT_COLOR
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.TextScaled = true
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Text = player.Name
        nameLabel.Parent = frame
    end
    
    -- شريط الصحة
    if CONFIG.ESP_SHOW_HEALTH then
        local healthBg = Instance.new("Frame")
        healthBg.Name = "HealthBg"
        healthBg.Size = UDim2.new(0.9, 0, 0.15, 0)
        healthBg.Position = UDim2.new(0.05, 0, 0.45, 0)
        healthBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        healthBg.BorderSizePixel = 0
        healthBg.Parent = frame
        
        local healthBgCorner = Instance.new("UICorner")
        healthBgCorner.CornerRadius = UDim.new(0, 4)
        healthBgCorner.Parent = healthBg
        
        local healthFill = Instance.new("Frame")
        healthFill.Name = "HealthFill"
        healthFill.Size = UDim2.new(1, 0, 1, 0)
        healthFill.BackgroundColor3 = CONFIG.ESP_HEALTH_COLOR
        healthFill.BorderSizePixel = 0
        healthFill.Parent = healthBg
        
        local healthFillCorner = Instance.new("UICorner")
        healthFillCorner.CornerRadius = UDim.new(0, 4)
        healthFillCorner.Parent = healthFill
        
        esp.HealthFill = healthFill
    end
    
    -- المسافة
    if CONFIG.ESP_SHOW_DISTANCE then
        local distLabel = Instance.new("TextLabel")
        distLabel.Name = "DistanceLabel"
        distLabel.Size = UDim2.new(1, 0, 0.3, 0)
        distLabel.Position = UDim2.new(0, 0, 0.7, 0)
        distLabel.BackgroundTransparency = 1
        distLabel.TextColor3 = CONFIG.ESP_TEXT_COLOR
        distLabel.TextStrokeTransparency = 0
        distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        distLabel.TextScaled = true
        distLabel.Font = Enum.Font.Gotham
        distLabel.Text = "0m"
        distLabel.Parent = frame
        
        esp.DistanceLabel = distLabel
    end
    
    esp.Billboard = billboard
    esp.Player = player
    
    espObjects[player] = esp
end

-- إزالة ESP للاعب
local function RemoveESP(player)
    local esp = espObjects[player]
    if not esp then return end
    
    if esp.Highlight then esp.Highlight:Destroy() end
    if esp.Billboard then esp.Billboard:Destroy() end
    
    espObjects[player] = nil
end

-- تحديث ESP لكل اللاعبين
local function UpdateESP()
    if not isESPEnabled then return end
    
    for player, esp in pairs(espObjects) do
        if not player.Character then
            RemoveESP(player)
            continue
        end
        
        local char = player.Character
        local head = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        
        if not head or not humanoid then continue end
        
        -- المسافة بين اللاعب والهدف
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then continue end
        
        local myPos = myChar.HumanoidRootPart.Position
        local targetPos = head.Position
        local distance = (myPos - targetPos).Magnitude
        
        -- إخفاء إذا بعيد جداً
        if esp.Billboard then
            esp.Billboard.Enabled = distance <= CONFIG.ESP_MAX_DISTANCE
        end
        if esp.Highlight then
            esp.Highlight.Enabled = distance <= CONFIG.ESP_MAX_DISTANCE
        end
        
        -- تحديث المسافة
        if esp.DistanceLabel then
            esp.DistanceLabel.Text = string.format("%dm", math.floor(distance))
        end
        
        -- تحديث شريط الصحة
        if esp.HealthFill then
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            esp.HealthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
            
            -- تغيير اللون حسب الصحة
            if healthPercent > 0.6 then
                esp.HealthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            elseif healthPercent > 0.3 then
                esp.HealthFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            else
                esp.HealthFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            end
        end
    end
end

-- تفعيل/إطفاء ESP لكل اللاعبين
local function SetESPState(enabled)
    if enabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                CreateESP(player)
            end
        end
    else
        for player, _ in pairs(espObjects) do
            RemoveESP(player)
        end
    end
end

