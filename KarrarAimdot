local function GetScreenCenter()
    local vp = Camera.ViewportSize
    if vp.X <= 0 or vp.Y <= 0 then vp = Vector2.new(1920, 1080) end
    return Vector2.new(vp.X / 2, vp.Y / 2)
end

local function HasLineOfSight(targetHead)
    local origin = Camera.CFrame.Position
    local direction = targetHead.Position - origin
    local distance = direction.Magnitude
    if distance > CONFIG.MAX_DISTANCE then return false end
    if distance < 0.1 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    local ignored = { LocalPlayer.Character }

    for _ = 1, 4 do
        params.FilterDescendantsInstances = ignored
        local result = workspace:Raycast(origin, direction, params)
        if not result then return true end
        if result.Instance then
            if result.Instance:IsDescendantOf(targetHead.Parent) then return true end
            if result.Instance.Transparency > 0.5 then
                table.insert(ignored, result.Instance)
                continue
            end
        end
        return false
    end
    return false
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
        return false
    end
    return true
end

local function IsValidTarget(player)
    if not IsEnemy(player) then return false, nil end
    local char = player.Character
    if not char or not char.Parent then return false, nil end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false, nil end
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Dead
       or state == Enum.HumanoidStateType.Dying
       or state == Enum.HumanoidStateType.FallingDown then
        return false, nil
    end
    local head = char:FindFirstChild("Head")
    if not head then return false, nil end
    if head.Transparency >= 0.9 then return false, nil end
    if not char:FindFirstChild("HumanoidRootPart") then return false, nil end
    if humanoid.PlatformStand then return false, nil end
    return true, head
end

local function FindBestTarget()
    local bestTarget = nil
    local bestScore = math.huge
    local screenCenter = GetScreenCenter()

    if currentTarget then
        if not currentTarget.Parent then
            currentTarget = nil
        else
            local valid, head = IsValidTarget(currentTarget)
            if valid then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if screenDist < CONFIG.FOV_RADIUS and HasLineOfSight(head) then
                        bestTarget = currentTarget
                        bestScore = screenDist * (1 - CONFIG.STICKINESS)
                    end
                end
            else
                currentTarget = nil
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == currentTarget then continue end
        local valid, head = IsValidTarget(player)
        if not valid then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if screenDist > CONFIG.FOV_RADIUS then continue end
        local worldDist = (Camera.CFrame.Position - head.Position).Magnitude
        if worldDist > CONFIG.MAX_DISTANCE then continue end
        if not HasLineOfSight(head) then continue end
        local score = screenDist + (worldDist * 0.05)
        if score < bestScore then
            bestScore = score
            bestTarget = player
        end
    end

    currentTarget = bestTarget
    return currentTarget
end

-- ═══════════════════════════════════════════
-- 👁️ ESP
-- ═══════════════════════════════════════════
local function CreateESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end
    if not player.Character then return end

    local isAlly = LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team
    local color = isAlly and CONFIG.ESP_ALLY_COLOR or CONFIG.ESP_COLOR

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = color
    highlight.FillTransparency = CONFIG.ESP_FILL_TRANSPARENCY
    highlight.OutlineColor = color
    highlight.OutlineTransparency = CONFIG.ESP_OUTLINE_TRANSPARENCY
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = player.Character
    highlight.Parent = player.Character

    espObjects[player] = { Highlight = highlight }
end

local function RemoveESP(player)
    local esp = espObjects[player]
    if not esp then return end
    if esp.Highlight and esp.Highlight.Parent then esp.Highlight:Destroy() end
    espObjects[player] = nil
end

local function ClearAllESP()
    local toRemove = {}
    for player in pairs(espObjects) do table.insert(toRemove, player) end
    for _, player in ipairs(toRemove) do RemoveESP(player) end
end

local function SetESPState(enabled)
    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then CreateESP(player) end
        end
    else
        ClearAllESP()
    end
end

local function UpdateESP(now)
    if now - lastESPUpdate < CONFIG.ESP_UPDATE_INTERVAL then return end
    lastESPUpdate = now
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local toRemove = {}
    for player, esp in pairs(espObjects) do
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            table.insert(toRemove, player)
            continue
        end
        if esp.Highlight and esp.Highlight.Adornee ~= char then
            esp.Highlight.Adornee = char
        end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 or not myRoot then
            if esp.Highlight then esp.Highlight.Enabled = false end
            continue
        end
        local distance = (myRoot.Position - char.HumanoidRootPart.Position).Magnitude
        if esp.Highlight then
            esp.Highlight.Enabled = distance <= CONFIG.ESP_MAX_DISTANCE
        end
    end
    for _, player in ipairs(toRemove) do RemoveESP(player) end
end

