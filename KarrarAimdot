-- 👥 إدارة اللاعبين
-- ═══════════════════════════════════════════
local function OnCharacterAdded(player, character)
    task.wait(0.5)
    if player.Parent and player.Character == character
       and isESPEnabled and player ~= LocalPlayer then
        CreateESP(player)
    end
end

local function SetupPlayerConnections(player)
    if player == LocalPlayer then return end
    if playerConnections[player] then return end
    playerConnections[player] = {
        CharacterAdded = player.CharacterAdded:Connect(function(char)
            OnCharacterAdded(player, char)
        end)
    }
    if player.Character and isESPEnabled then
        OnCharacterAdded(player, player.Character)
    end
end

Players.PlayerAdded:Connect(SetupPlayerConnections)
for _, player in ipairs(Players:GetPlayers()) do
    SetupPlayerConnections(player)
end

Players.PlayerRemoving:Connect(function(player)
    local conns = playerConnections[player]
    if conns then
        if conns.CharacterAdded then conns.CharacterAdded:Disconnect() end
        playerConnections[player] = nil
    end
    RemoveESP(player)
end)

