-- ═══════════════════════════════════════════
-- 🎮 دوال التبديل
-- ═══════════════════════════════════════════
local function ToggleAim()
    isAiming = not isAiming
    if not isAiming then
        currentTarget = nil
        smoothedTargetPosition = nil
        lastTargetHead = nil
    end
    UpdateAimButton()
end

local function ToggleESP()
    isESPEnabled = not isESPEnabled
    SetESPState(isESPEnabled)
    UpdateESPButton()
end

-- ═══════════════════════════════════════════
-- ⌨️ ربط الكيبورد
-- ═══════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == CONFIG.AIM_KEY then ToggleAim() end
    if input.KeyCode == CONFIG.ESP_KEY then ToggleESP() end
end)

aimButton.MouseButton1Click:Connect(ToggleAim)
espButton.MouseButton1Click:Connect(ToggleESP)

-- ═══════════════════════════════════════════
-- 🔄 إدارة اللاعبين
-- ═══════════════════════════════════════════
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if isESPEnabled and player ~= LocalPlayer then
            CreateESP(player)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    RemoveESP(player)
end)

-- ═══════════════════════════════════════════
-- 🔄 الحلقة الرئيسية (محسّنة للأداء)
-- ═══════════════════════════════════════════
RunService.RenderStepped:Connect(function(deltaTime)
    local now = tick()
    
    -- ─────────────────────────────────────
    -- 🎯 التصويب الناعم (كل إطار - ضروري للنعومة)
    -- ─────────────────────────────────────
    if isAiming and LocalPlayer.Character then
        local target = FindBestTarget()
        
        if target then
            local targetHead = target.Character and target.Character:FindFirstChild("Head")
            
            if targetHead then
                if lastTargetHead ~= targetHead then
                    lastTargetHead = targetHead
                    smoothedTargetPosition = targetHead.Position + CONFIG.HEAD_OFFSET
                end
                
                local rawTargetPos = targetHead.Position + CONFIG.HEAD_OFFSET
                local targetSmoothFactor = 1 - math.pow(1 - CONFIG.TARGET_SMOOTHNESS, deltaTime * 60)
                smoothedTargetPosition = smoothedTargetPosition:Lerp(rawTargetPos, targetSmoothFactor)
                
                local cameraPos = Camera.CFrame.Position
                local direction = smoothedTargetPosition - cameraPos
                local distanceToTarget = direction.Magnitude
                
                if distanceToTarget > CONFIG.AIM_DEAD_ZONE then
                    local goalCFrame = CFrame.lookAt(cameraPos, smoothedTargetPosition)
                    
                    local distanceRatio = math.clamp(distanceToTarget / 50, 0, 1)
                    local adaptiveSmoothness = math.max(CONFIG.AIM_SMOOTHNESS * distanceRatio, 0.05)
                    local smoothFactor = 1 - math.pow(1 - adaptiveSmoothness, deltaTime * 60)
                    
                    local newCFrame = Camera.CFrame:Lerp(goalCFrame, smoothFactor)
                    
                    local currentLook = Camera.CFrame.LookVector
                    local newLook = newCFrame.LookVector
                    local blendedLook = currentLook:Lerp(newLook, 0.7).Unit
                    
                    Camera.CFrame = CFrame.lookAt(cameraPos, cameraPos + blendedLook)
                end
            end
        else
            smoothedTargetPosition = nil
            lastTargetHead = nil
        end
    end
    
    -- ─────────────────────────────────────
    -- 👁️ ESP (كل 0.1 ثانية فقط - لا يسبب لاق)
    -- ─────────────────────────────────────
    if isESPEnabled then
        UpdateESP(now)
    end
end)

