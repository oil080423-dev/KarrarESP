-- ═══════════════════════════════════════════
-- 🎮 دوال التبديل
-- ═══════════════════════════════════════════
local function ToggleAim()
    isAiming = not isAiming
    if not isAiming then currentTarget = nil end
    UpdateAimButton()
    print(isAiming and "🎯 التصويب: مفعّل" or "🎯 التصويب: متوقف")
end

local function ToggleESP()
    isESPEnabled = not isESPEnabled
    SetESPState(isESPEnabled)
    UpdateESPButton()
    print(isESPEnabled and "👁️ ESP: مفعّل" or "👁️ ESP: متوقف")
end

