-- 🔄 الحلقة الرئيسية
-- ═══════════════════════════════════════════
local function IsAimingActive()
    if IS_MOBILE then
        -- ✅ على الهاتف: (مثبّت) أو (مضغوط) أو (زر مخفي)
        return isAiming and (isTriggerLocked or isTriggerHeld or not triggerButton.Visible)
    end
    return isAiming
end

RunService.RenderStepped:Connect(function(deltaTime)
    local now = tick()
    local aimingActive = IsAimingActive()

    fovCircle.Visible = aimingActive
    crosshairContainer.Visible = aimingActive

    if aimingActive and LocalPlayer.Character then
        local target = FindBestTarget()

        if CONFIG.DEBUG and now - lastDebugPrint > 1 then
            lastDebugPrint = now
            print(target and ("🎯 الهدف: " .. target.Name) or "🔍 لا يوجد هدف")
        end

        if target then
            local targetHead = target.Character and target.Character:FindFirstChild("Head")
            if targetHead then
                local rawTargetPos = targetHead.Position + CONFIG.HEAD_OFFSET

                if lastTargetHead ~= targetHead then
                    lastTargetHead = targetHead
                    smoothedTargetPosition = rawTargetPos
                    lastRawTargetPos = rawTargetPos
                    targetVelocity = Vector3.zero
                end

                if lastRawTargetPos and deltaTime > 0 then
                    local instantVelocity = (rawTargetPos - lastRawTargetPos) / deltaTime
                    if instantVelocity.Magnitude > CONFIG.MAX_TARGET_SPEED then
                        instantVelocity = instantVelocity.Unit * CONFIG.MAX_TARGET_SPEED
                    end
                    local velLerp = 1 - math.pow(0.5, deltaTime * 60)
                    targetVelocity = targetVelocity:Lerp(instantVelocity, velLerp)
                end
                lastRawTargetPos = rawTargetPos

                local predictedPos = rawTargetPos + (targetVelocity * CONFIG.PREDICTION_STRENGTH * deltaTime)
                local targetSmooth = 1 - math.pow(1 - CONFIG.TARGET_SMOOTHNESS, deltaTime * 60)
                smoothedTargetPosition = smoothedTargetPosition:Lerp(predictedPos, targetSmooth)

                local cameraPos = Camera.CFrame.Position
                local direction = smoothedTargetPosition - cameraPos
                local distanceToTarget = direction.Magnitude

                if distanceToTarget > CONFIG.AIM_DEAD_ZONE then
                    local desiredCFrame = CFrame.lookAt(cameraPos, smoothedTargetPosition)
                    local desiredLook = desiredCFrame.LookVector

                    local speedFactor = math.clamp(targetVelocity.Magnitude / 200, 0, 0.10)
                    local distanceFactor = math.clamp(distanceToTarget / 100, 0, 1)
                    local effectiveSmoothness = math.clamp(
                        CONFIG.AIM_SMOOTHNESS * distanceFactor + speedFactor,
                        0.05, 0.95
                    )
                    local smoothFactor = 1 - math.pow(1 - effectiveSmoothness, deltaTime * 60)

                    local currentLook = Camera.CFrame.LookVector
                    local blendedLook = currentLook:Lerp(desiredLook, smoothFactor)
                    if blendedLook.Magnitude < 0.001 then
                        blendedLook = desiredLook
                    end
                    blendedLook = blendedLook.Unit

                    if CONFIG.VERTICAL_LOCK then
                        local lookXZ = Vector3.new(blendedLook.X, 0, blendedLook.Z)
                        if lookXZ.Magnitude > 0.01 then
                            lookXZ = lookXZ.Unit
                            local dx = smoothedTargetPosition.X - cameraPos.X
                            local dz = smoothedTargetPosition.Z - cameraPos.Z
                            local horizontalDist = math.sqrt(dx * dx + dz * dz)
                            if horizontalDist < 0.5 then horizontalDist = 0.5 end

                            local finalTarget = Vector3.new(
                                cameraPos.X + lookXZ.X * horizontalDist,
                                smoothedTargetPosition.Y,
                                cameraPos.Z + lookXZ.Z * horizontalDist
                            )
                            if (finalTarget - cameraPos).Magnitude > 0.01 then
                                Camera.CFrame = CFrame.lookAt(cameraPos, finalTarget)
                            end
                        end
                    else
                        local lookTarget = cameraPos + blendedLook
                        if (lookTarget - cameraPos).Magnitude > 0.01 then
                            Camera.CFrame = CFrame.lookAt(cameraPos, lookTarget)
                        end
                    end
                end
            end
        else
            smoothedTargetPosition = nil
            lastTargetHead = nil
            lastRawTargetPos = nil
            targetVelocity = Vector3.zero
        end
    end

    if isESPEnabled then
        UpdateESP(now)
    end
end)

