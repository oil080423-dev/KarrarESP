-- LocalScript في StarterPlayerScripts
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local camera = workspace.CurrentCamera
local localPlayer = Players.LocalPlayer

-- ⚙️ إعدادات Aim Assist
local ASSIST_STRENGTH = 0.95
local MAX_DISTANCE = 300
local FOV_ANGLE = 120
local SMOOTHING = 40
local AIM_HEIGHT_OFFSET = 0.5

-- ⚙️ إعدادات ESP
local ESP_FILL_COLOR = Color3.fromRGB(255, 0, 0)
local ESP_OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)
local ESP_FILL_TRANSPARENCY = 0.5
local ESP_SHOW_NAME = true
local ESP_SHOW_DISTANCE = true
local ESP_MAX_DISTANCE = 500

------------------------------------------------------------
-- 🎯 Aim Assist
------------------------------------------------------------
local function getBestTarget()
    local bestTarget = nil
    local bestScore = math.huge
    local camPos = camera.CFrame.Position
    local camLook = camera.CFrame.LookVector

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == localPlayer then continue end
        local char = plr.Character
        if not char then continue end

        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp or not hum or hum.Health <= 0 then continue end

        local dir = hrp.Position - camPos
        local dist = dir.Magnitude
        if dist > MAX_DISTANCE then continue end

        local angle = math.deg(math.acos(math.clamp(camLook:Dot(dir.Unit), -1, 1)))
        if angle > FOV_ANGLE then continue end

        local score = angle + (dist / MAX_DISTANCE) * 15
        if score < bestScore then
            bestScore = score
            bestTarget = hrp
        end
    end
    return bestTarget
end

RunService.RenderStepped:Connect(function(dt)
    local target = getBestTarget()
    if not target then return end

    local aimPoint = target.Position + Vector3.new(0, AIM_HEIGHT_OFFSET, 0)
    local currentCF = camera.CFrame
    local targetCF = CFrame.new(currentCF.Position, aimPoint)

    local alpha = math.clamp(ASSIST_STRENGTH * SMOOTHING * dt, 0, 1)
    camera.CFrame = currentCF:Lerp(targetCF, alpha)
end)

------------------------------------------------------------
-- 👁️ ESP (Highlight + BillboardGui)
------------------------------------------------------------
local espObjects = {}

local function createESP(plr)
    if plr == localPlayer then return end
    local char = plr.Character
    if not char then return end

    -- Highlight (يظهر عبر الجدران)
    local hl = Instance.new("Highlight")
    hl.Name = "AssistESP_Highlight"
    hl.FillColor = ESP_FILL_COLOR
    hl.OutlineColor = ESP_OUTLINE_COLOR
    hl.FillTransparency = ESP_FILL_TRANSPARENCY
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char

    -- BillboardGui فوق الرأس (اسم + مسافة)
    local head = char:FindFirstChild("Head")
    local billboard
    if head then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "AssistESP_Billboard"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = ESP_MAX_DISTANCE
        billboard.Parent = head

        local label = Instance.new("TextLabel")
        label.Name = "InfoLabel"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = ESP_FILL_COLOR
        label.TextStrokeTransparency = 0
        label.Font = Enum.Font.GothamBold
        label.TextSize = 16
        label.Text = ""
        label.Parent = billboard
    end

    espObjects[plr] = {highlight = hl, billboard = billboard, label = billboard and billboard:FindFirstChild("InfoLabel")}
end

local function removeESP(plr)
    local data = espObjects[plr]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        espObjects[plr] = nil
    end
end

-- تحديث النص (اسم + مسافة)
RunService.Heartbeat:Connect(function()
    for plr, data in pairs(espObjects) do
        if not data.label then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hrp and hum and hum.Health > 0 then
            local dist = math.floor((hrp.Position - camera.CFrame.Position).Magnitude)
            local parts = {}
            if ESP_SHOW_NAME then table.insert(parts, plr.Name) end
            if ESP_SHOW_DISTANCE then table.insert(parts, "[" .. dist .. "m]") end
            data.label.Text = table.concat(parts, " ")
        else
            data.label.Text = ""
        end
    end
end)

-- ربط الأحداث
local function onCharacterAdded(plr, char)
    task.wait(0.5)
    createESP(plr)
end

local function onPlayerAdded(plr)
    if plr == localPlayer then return end
    plr.CharacterAdded:Connect(function(char) onCharacterAdded(plr, char) end)
    if plr.Character then createESP(plr) end
end

for _, plr in ipairs(Players:GetPlayers()) do onPlayerAdded(plr) end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(removeESP)
