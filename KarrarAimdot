local LocalPlayer = Players.LocalPlayer

-- ═══════════════════════════════════════════
-- ⚙️ الإعدادات
-- ═══════════════════════════════════════════
local CONFIG = {
    -- 🎯 التصويب
    FOV_RADIUS = 180,              -- نطاق FOV (بكسل على الشاشة)
    AIM_SMOOTHNESS = 0.40,         -- نعومة التصويب
    AIM_DEAD_ZONE = 0.4,           -- منطقة ميتة (يمنع الاهتزاز)
    TARGET_SMOOTHNESS = 0.45,      -- نعومة تتبع الهدف
    STICKINESS = 0.90,             -- ثبات قوي على الهدف
    MAX_DISTANCE = 600,            -- أقصى مسافة للتصويب
    HEAD_OFFSET = Vector3.new(0, 0, 0),
    AIM_KEY = Enum.KeyCode.Q,
    
    -- 👁️ ESP (بسيط جداً)
    ESP_KEY = Enum.KeyCode.E,
    ESP_MAX_DISTANCE = 800,
    ESP_COLOR = Color3.fromRGB(255, 40, 40),  -- أحمر فقط
    ESP_FILL_TRANSPARENCY = 0.75,              -- شفاف جداً (لا يزعج)
    ESP_OUTLINE_TRANSPARENCY = 0,
    
    -- ⚡ الأداء (بدون لاق)
    ESP_UPDATE_INTERVAL = 0.1,     -- تحديث ESP كل 0.1 ثانية فقط (وليس كل إطار)
    UI_UPDATE_INTERVAL = 0.2,      -- تحديث المسافة كل 0.2 ثانية
}

-- ═══════════════════════════════════════════
-- 📦 المتغيرات
-- ═══════════════════════════════════════════
local currentTarget = nil
local isAiming = false
local isESPEnabled = false
local espObjects = {}
local smoothedTargetPosition = nil
local lastTargetHead = nil
local lastESPUpdate = 0
local lastUIUpdate = 0

-- ═══════════════════════════════════════════
-- 🛠️ دوال التصويب (محسّنة للأداء)
-- ═══════════════════════════════════════════

-- فحص خط الرؤية (خفيف)
local function HasLineOfSight(targetHead)
    local origin = Camera.CFrame.Position
    local direction = targetHead.Position - origin
    local distance = direction.Magnitude
    
    if distance > CONFIG.MAX_DISTANCE then return false, distance end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local result = workspace:Raycast(origin, direction, params)
    
    if not result then return true, distance end
    if result.Instance and result.Instance:IsDescendantOf(targetHead.Parent) then
        return true, distance
    end
    return false, distance
end

-- المسافة على الشاشة (خفيف جداً)
local function GetScreenDistance(targetHead)
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
    if not onScreen then return math.huge end
    
    local mousePos = UserInputService:GetMouseLocation()
    return (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
        return false
    end
    return true
end

local function IsValidTarget(player)
    if not IsEnemy(player) then return false end
    local char = player.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    return true, head
end

-- 🔹 إيجاد أفضل هدف (محسّن - فلترة سريعة أولاً)
local function FindBestTarget()
    local bestTarget = nil
    local bestScore = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    
    -- فحص الهدف الحالي أولاً (للثبات)
    if currentTarget then
        local valid, head = IsValidTarget(currentTarget)
        if valid then
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if screenDist < CONFIG.FOV_RADIUS then
                    local hasLOS = HasLineOfSight(head)
                    if hasLOS then
                        bestTarget = currentTarget
                        bestScore = screenDist * (1 - CONFIG.STICKINESS)
                    end
                end
            end
        else
            currentTarget = nil
        end
    end
    
    -- البحث عن أهداف جديدة
    for _, player in pairs(Players:GetPlayers()) do
        if player == currentTarget then continue end
        local valid, head = IsValidTarget(player)
        if not valid then continue end
        
        -- فلترة سريعة: المسافة على الشاشة (بدون Raycast)
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        
        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if screenDist > CONFIG.FOV_RADIUS then continue end
        
        -- فلترة المسافة في العالم (سريعة)
        local worldDist = (Camera.CFrame.Position - head.Position).Magnitude
        if worldDist > CONFIG.MAX_DISTANCE then continue end
        
        -- فحص خط الرؤية (ثقيل - لكن فقط للأهداف المرشحة)
        local hasLOS = HasLineOfSight(head)
        if not hasLOS then continue end
        
        local score = screenDist + (worldDist * 0.05)
        if score < bestScore then
            bestScore = score
            bestTarget = player
        end
    end
    
    currentTarget = bestTarget
    return currentTarget
end

-- ═══════════════════════════════════════════
-- 👁️ ESP بسيط جداً (Highlight فقط - بدون أسماء أو أيقونات)
-- ═══════════════════════════════════════════

local function CreateESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = CONFIG.ESP_COLOR
    highlight.FillTransparency = CONFIG.ESP_FILL_TRANSPARENCY
    highlight.OutlineColor = CONFIG.ESP_COLOR
    highlight.OutlineTransparency = CONFIG.ESP_OUTLINE_TRANSPARENCY
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = player.Character
    highlight.Parent = player.Character
    
    espObjects[player] = { Highlight = highlight }
end

local function RemoveESP(player)
    local esp = espObjects[player]
    if not esp then return end
    if esp.Highlight then esp.Highlight:Destroy() end
    espObjects[player] = nil
end

local function SetESPState(enabled)
    if enabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                CreateESP(player)
            end
        end
    else
        for player, _ in pairs(espObjects) do
            RemoveESP(player)
        end
    end
end

-- تحديث ESP (مُحسّن - كل 0.1 ثانية فقط)
local function UpdateESP(now)
    if now - lastESPUpdate < CONFIG.ESP_UPDATE_INTERVAL then return end
    lastESPUpdate = now
    
    for player, esp in pairs(espObjects) do
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            RemoveESP(player)
            continue
        end
        
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then continue end
        
        local distance = (myChar.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
        
        if esp.Highlight then
            esp.Highlight.Enabled = distance <= CONFIG.ESP_MAX_DISTANCE
        end
    end
end

