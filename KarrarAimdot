local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 150
local MAX_DISTANCE = 300

local ESP_COLOR = Color3.fromRGB(170, 70, 255)
local FOV_COLOR = Color3.fromRGB(255, 0, 0)

local Enabled = true
local Highlights = {}

-- GUI
local GUI = Instance.new("ScreenGui")
GUI.Name = "KarrarKnifeSystem"
GUI.ResetOnSpawn = false
GUI.Parent = LocalPlayer.PlayerGui

-- RED FOV
local Circle = Instance.new("Frame")
Circle.Size = UDim2.fromOffset(
    FOV_RADIUS * 2,
    FOV_RADIUS * 2
)
Circle.AnchorPoint = Vector2.new(0.5, 0.5)
Circle.Position = UDim2.fromScale(0.5, 0.5)
Circle.BackgroundTransparency = 1
Circle.Parent = GUI

local Round = Instance.new("UICorner")
Round.CornerRadius = UDim.new(1, 0)
Round.Parent = Circle

local Stroke = Instance.new("UIStroke")
Stroke.Color = FOV_COLOR
Stroke.Thickness = 2
Stroke.Parent = Circle

-- STATUS
local Status = Instance.new("TextLabel")
Status.Size = UDim2.fromOffset(200, 35)
Status.Position = UDim2.new(0.5, -100, 0.72, 0)
Status.BackgroundTransparency = 1
Status.TextColor3 = Color3.new(1, 1, 1)
Status.TextScaled = true
Status.Parent = GUI

-- ESP
local function RemoveESP(Player)
    if Highlights[Player] then
        Highlights[Player]:Destroy()
        Highlights[Player] = nil
    end
end

local function CreateESP(Player)
    if Player == LocalPlayer then return end
    if Player:GetAttribute("AllowCameraAssist") ~= true then return end

    local Character = Player.Character
    if not Character then return end

    RemoveESP(Player)

    local Highlight = Instance.new("Highlight")
    Highlight.Adornee = Character
    Highlight.FillColor = ESP_COLOR
    Highlight.OutlineColor = ESP_COLOR
    Highlight.FillTransparency = 0.8
    Highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    Highlight.Parent = GUI

    Highlights[Player] = Highlight
end

-- TARGET INDICATOR
local function GetTargetCount()
    local Count = 0

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer
        and Player:GetAttribute("AllowCameraAssist") == true then

            local Character = Player.Character
            local Head = Character and Character:FindFirstChild("Head")
            local Humanoid = Character
                and Character:FindFirstChildOfClass("Humanoid")

            if Head and Humanoid and Humanoid.Health > 0 then

                local Position, Visible =
                    Camera:WorldToViewportPoint(Head.Position)

                local Center = Camera.ViewportSize / 2

                local ScreenDistance = (
                    Vector2.new(Position.X, Position.Y) - Center
                ).Magnitude

                local WorldDistance = (
                    Camera.CFrame.Position - Head.Position
                ).Magnitude

                if Visible
                and ScreenDistance <= FOV_RADIUS
                and WorldDistance <= MAX_DISTANCE then
                    Count += 1
                end
            end
        end
    end

    return Count
end

-- UPDATE
RunService.RenderStepped:Connect(function()

    if not Enabled then return end

    Circle.Position = UDim2.fromOffset(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    Status.Text = "Targets: " .. GetTargetCount()

end)

-- PLAYER EVENTS
local function SetupPlayer(Player)

    if Player == LocalPlayer then return end

    Player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if Enabled then
            CreateESP(Player)
        end
    end)

    if Player.Character then
        CreateESP(Player)
    end
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
    RemoveESP(Player)
end)

for _, Player in ipairs(Players:GetPlayers()) do
    SetupPlayer(Player)
end

print("KARRAR SYSTEM LOADED")
