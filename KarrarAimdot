    RemoveESP(player)
end)

-- ═══════════════════════════════════════════
-- 🔄 الحلقة الرئيسية
-- ═══════════════════════════════════════════
RunService.RenderStepped:Connect(function(deltaTime)
    -- التصويب
    if isAiming and LocalPlayer.Character then
        local target = FindBestTarget()
        if target then
            local targetHead = target.Character and target.Character:FindFirstChild("Head")
            if targetHead then
                local targetPosition = targetHead.Position + CONFIG.HEAD_OFFSET
                local cameraPos = Camera.CFrame.Position
                local goalCFrame = CFrame.lookAt(cameraPos, targetPosition)
                local smoothFactor = 1 - math.pow(1 - CONFIG.AIM_SMOOTHNESS, deltaTime * 60)
                Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, smoothFactor)
            end
        end
    end
    
    -- ESP
    if isESPEnabled then
        UpdateESP()
    end
end)

