-- 🔄 الحلقة الرئيسية (AIM_SMOOTHNESS 0.70)
-- ═══════════════════════════════════════════
RunService.RenderStepped:Connect(function(deltaTime)
    local now = tick()
    
    if isAiming then
        fovCircle.Visible = true
        crosshairContainer.Visible = true
    else
        fovCircle.Visible = false
        crosshairContainer.Visible = false
    end
    
    if isAiming and LocalPlayer.Character then
        local target = FindBestTarget()
        
        if CONFIG.DEBUG and now - lastDebugPrint > 1 then
            lastDebugPrint = now
            if target then
                print("🎯 الهدف:", target.Name)
            else
                print("🔍 لا يوجد هدف في النطاق")
            end
        end
        
        if target then
            local targetHead = target.Character and target.Character:FindFirstChild("Head")
            
            if targetHead then
                local rawTargetPos = targetHead.Position + CONFIG.HEAD_OFFSET
                
                if lastTargetHead ~= targetHead then
                    lastTargetHead = targetHead
                    smoothedTargetPosition = rawTargetPos
                    lastRawTargetPos = rawTargetPos
                    targetVelocity = Vector3.zero
                end
                
                -- 1. حساب سرعة الهدف
                if lastRawTargetPos and deltaTime > 0 then
                    local instantVelocity = (rawTargetPos - lastRawTargetPos) / deltaTime
                    targetVelocity = targetVelocity:Lerp(instantVelocity, 0.5)
                end
                lastRawTargetPos = rawTargetPos
                
                -- 2. توقع الموقع
                local predictedPos = rawTargetPos + (targetVelocity * CONFIG.PREDICTION_STRENGTH * deltaTime)
                
                -- 3. تنعيم موقع الهدف
                local targetSmoothFactor = 1 - math.pow(1 - CONFIG.TARGET_SMOOTHNESS, deltaTime * 60)
                smoothedTargetPosition = smoothedTargetPosition:Lerp(predictedPos, targetSmoothFactor)
                
                local cameraPos = Camera.CFrame.Position
                local direction = smoothedTargetPosition - cameraPos
                local distanceToTarget = direction.Magnitude
                
                if distanceToTarget > CONFIG.AIM_DEAD_ZONE then
                    local goalCFrame = CFrame.lookAt(cameraPos, smoothedTargetPosition)
                    
                    -- 4. نعومة متغيرة
                    local movementSpeed = targetVelocity.Magnitude
                    local speedBoost = math.clamp(movementSpeed / 80, 0, 0.15)
                    
                    local distanceRatio = math.clamp(distanceToTarget / 100, 0, 1)
                    local baseSmoothness = CONFIG.AIM_SMOOTHNESS * distanceRatio
                    local adaptiveSmoothness = math.max(baseSmoothness + speedBoost, 0.08)
                    
                    local smoothFactor = 1 - math.pow(1 - adaptiveSmoothness, deltaTime * 60)
                    
                    local newCFrame = Camera.CFrame:Lerp(goalCFrame, smoothFactor)
                    
                    -- 5. مزج الاتجاه
                    local currentLook = Camera.CFrame.LookVector
                    local newLook = newCFrame.LookVector
                    local blendFactor = 0.65 + math.clamp(movementSpeed / 120, 0, 0.2)
                    local blendedLook = currentLook:Lerp(newLook, blendFactor).Unit
                    
                    -- 6. Vertical Lock
                    if CONFIG.VERTICAL_LOCK then
                        local targetY = smoothedTargetPosition.Y
                        local finalTarget = Vector3.new(
                            cameraPos.X + blendedLook.X * distanceToTarget,
                            targetY,
                            cameraPos.Z + blendedLook.Z * distanceToTarget
                        )
                        Camera.CFrame = CFrame.lookAt(cameraPos, finalTarget)
                    else
                        Camera.CFrame = CFrame.lookAt(cameraPos, cameraPos + blendedLook)
                    end
                end
            end
        else
            smoothedTargetPosition = nil
            lastTargetHead = nil
            lastRawTargetPos = nil
            targetVelocity = Vector3.zero
        end
    end
    
    if isESPEnabled then
        UpdateESP(now)
    end
end)

