-- CHECK TARGET INSIDE CIRCLE
local function IsInsideCircle(Character, Camera)
    local Center = Circle.AbsolutePosition + Circle.AbsoluteSize / 2
    local Radius = CIRCLE_SIZE / 2

    local Parts = {
        Character:FindFirstChild("HumanoidRootPart"),
        Character:FindFirstChild("UpperTorso"),
        Character:FindFirstChild("Torso"),
        Character:FindFirstChild("Head")
    }

    for _, Part in ipairs(Parts) do
        if Part then
            local Point, Visible =
                Camera:WorldToViewportPoint(Part.Position)

            if Visible then
                local ScreenPosition = Vector2.new(Point.X, Point.Y)

                if (ScreenPosition - Center).Magnitude <= Radius then
                    return true
                end
            end
        end
    end

    return false
end

-- FIND TARGET
local function GetTarget(Camera)
    local BestTarget = nil
    local BestDistance = math.huge

    local Center = Circle.AbsolutePosition + Circle.AbsoluteSize / 2

    for _, OtherPlayer in ipairs(Players:GetPlayers()) do
        if OtherPlayer ~= Player then
            local Character = OtherPlayer.Character

            if Character then
                local Humanoid =
                    Character:FindFirstChildOfClass("Humanoid")

                local Head = Character:FindFirstChild("Head")

                if Humanoid and Head
                and Humanoid.Health > 0
                and IsInsideCircle(Character, Camera) then

                    local Point, Visible =
                        Camera:WorldToViewportPoint(Head.Position)

                    if Visible then
                        local Distance =
                            (Vector2.new(Point.X, Point.Y) - Center).Magnitude

                        if Distance < BestDistance then
                            BestDistance = Distance
                            BestTarget = Head
                        end
                    end
                end
            end
        end
    end

    return BestTarget
end

-- AIM UPDATE
RunService:BindToRenderStep(
    "KARRAR_AIM_V2",
    Enum.RenderPriority.Camera.Value + 1,
    function(DeltaTime)

        local Camera = workspace.CurrentCamera

        if not AIM_ENABLED or not Camera then
            LockedTarget = nil
            return
        end

        local TargetHead = GetTarget(Camera)

        if TargetHead then
            local Goal = CFrame.lookAt(
                Camera.CFrame.Position,
                TargetHead.Position
            )

            local Alpha = 1 - math.exp(-SMOOTHNESS * DeltaTime)

            Camera.CFrame = Camera.CFrame:Lerp(Goal, Alpha)
        end
    end
)

