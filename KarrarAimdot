-- 🛠️ دوال التصويب
-- ═══════════════════════════════════════════

local function GetScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function HasLineOfSight(targetHead)
    local origin = Camera.CFrame.Position
    local direction = targetHead.Position - origin
    local distance = direction.Magnitude
    if distance > CONFIG.MAX_DISTANCE then return false, distance end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local result = workspace:Raycast(origin, direction, params)
    if not result then return true, distance end
    if result.Instance and result.Instance:IsDescendantOf(targetHead.Parent) then
        return true, distance
    end
    return false, distance
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
        return false
    end
    return true
end

local function IsValidTarget(player)
    if not IsEnemy(player) then return false end
    
    local char = player.Character
    if not char then return false end
    if not char.Parent then return false end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    if humanoid.Health <= 0 then return false end
    
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Dead 
       or state == Enum.HumanoidStateType.Dying 
       or state == Enum.HumanoidStateType.FallingDown then
        return false end
    
    local head = char:FindFirstChild("Head")
    if not head then return false end
    
    if head.Transparency >= 0.9 then return false end
    
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    
    if humanoid.PlatformStand then return false end
    
    return true, head
end

local function FindBestTarget()
    local bestTarget = nil
    local bestScore = math.huge
    local screenCenter = GetScreenCenter()
    
    if currentTarget then
        local valid, head = IsValidTarget(currentTarget)
        if valid then
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if screenDist < CONFIG.FOV_RADIUS then
                    local hasLOS = HasLineOfSight(head)
                    if hasLOS then
                        bestTarget = currentTarget
                        bestScore = screenDist * (1 - CONFIG.STICKINESS)
                    end
                end
            end
        else
            currentTarget = nil
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == currentTarget then continue end
        local valid, head = IsValidTarget(player)
        if not valid then continue end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        
        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if screenDist > CONFIG.FOV_RADIUS then continue end
        
        local worldDist = (Camera.CFrame.Position - head.Position).Magnitude
        if worldDist > CONFIG.MAX_DISTANCE then continue end
        
        local hasLOS = HasLineOfSight(head)
        if not hasLOS then continue end
        
        local score = screenDist + (worldDist * 0.05)
        if score < bestScore then
            bestScore = score
            bestTarget = player
        end
    end
    
    currentTarget = bestTarget
    return currentTarget
end

-- ═══════════════════════════════════════════
-- 👁️ ESP
-- ═══════════════════════════════════════════

local function CreateESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = CONFIG.ESP_COLOR
    highlight.FillTransparency = CONFIG.ESP_FILL_TRANSPARENCY
    highlight.OutlineColor = CONFIG.ESP_COLOR
    highlight.OutlineTransparency = CONFIG.ESP_OUTLINE_TRANSPARENCY
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = player.Character
    highlight.Parent = player.Character
    
    espObjects[player] = { Highlight = highlight }
end

local function RemoveESP(player)
    local esp = espObjects[player]
    if not esp then return end
    if esp.Highlight then esp.Highlight:Destroy() end
    espObjects[player] = nil
end

local function SetESPState(enabled)
    if enabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                CreateESP(player)
            end
        end
    else
        for player, _ in pairs(espObjects) do
            RemoveESP(player)
        end
    end
end

local function UpdateESP(now)
    if now - lastESPUpdate < CONFIG.ESP_UPDATE_INTERVAL then return end
    lastESPUpdate = now
    
    for player, esp in pairs(espObjects) do
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            RemoveESP(player)
            continue
        end
        
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        local myChar = LocalPlayer.Character
        
        if not humanoid or humanoid.Health <= 0 or not myChar or not myChar:FindFirstChild("HumanoidRootPart") then
            if esp.Highlight then esp.Highlight.Enabled = false end
            continue
        end
        
        local distance = (myChar.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
        if esp.Highlight then
            esp.Highlight.Enabled = distance <= CONFIG.ESP_MAX_DISTANCE
        end
    end
end

