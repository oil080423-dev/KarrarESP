local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local consent = ReplicatedStorage:WaitForChild("TrackingConsent")

local enabled = false
local allowed = false
local target = nil

local gui = Instance.new("ScreenGui")
gui.Name = "TrackingSystem"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local circle = Instance.new("Frame")
circle.Size = UDim2.fromOffset(160, 160)
circle.Position = UDim2.new(0.5, -80, 0.5, -80)
circle.BackgroundTransparency = 1
circle.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = circle

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Color = Color3.fromRGB(255, 0, 0)
stroke.Parent = circle

local function makeButton(text, position)
	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(150, 40)
	button.Position = position
	button.Text = text
	button.TextScaled = true
	button.Parent = gui
	return button
end

local trackButton = makeButton(
	"TRACK: OFF",
	UDim2.new(0.5, -75, 1, -100)
)

local consentButton = makeButton(
	"ALLOW: OFF",
	UDim2.new(0.5, -75, 1, -150)
)

consentButton.Activated:Connect(function()
	allowed = not allowed
	consent:FireServer(allowed)
	consentButton.Text = allowed and "ALLOW: ON" or "ALLOW: OFF"
end)

trackButton.Activated:Connect(function()
	enabled = not enabled
	target = nil

	trackButton.Text = enabled and "TRACK: ON" or "TRACK: OFF"
	stroke.Color = enabled
		and Color3.fromRGB(0, 255, 0)
		or Color3.fromRGB(255, 0, 0)
end)

local function findTarget()
	local closest = nil
	local shortest = math.huge
	local center = circle.AbsolutePosition + Vector2.new(80, 80)

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player
			and other:GetAttribute("AllowTracking") == true then

			local character = other.Character
			local head = character and character:FindFirstChild("Head")

			if head then
				local point, visible =
					camera:WorldToViewportPoint(head.Position)

				if visible and point.Z > 0 then
					local distance = (
						Vector2.new(point.X, point.Y) - center
					).Magnitude

					if distance <= 80 and distance < shortest then
						shortest = distance
						closest = head
					end
				end
			end
		end
	end

	return closest
end

RunService.RenderStepped:Connect(function()
	if not enabled then
		target = nil
		return
	end

	if not target or not target.Parent then
		target = findTarget()
	end

	if target then
		local desired = CFrame.lookAt(
			camera.CFrame.Position,
			target.Position
		)

		camera.CFrame = camera.CFrame:Lerp(desired, 0.18)
	end
end)
