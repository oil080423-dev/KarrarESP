-- Karrar Head Tracker V2
-- Mobile + PC
-- Visual Head Tracking

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Camera = workspace.CurrentCamera

local Enabled = true
local FOVRadius = 150
local CurrentTarget = nil
local CurrentHighlight = nil

-- GUI
local GUI = Instance.new("ScreenGui")
GUI.Name = "KarrarHeadTracker"
GUI.ResetOnSpawn = false
GUI.IgnoreGuiInset = true
GUI.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- FOV Circle
local Circle = Instance.new("Frame")
Circle.Name = "FOV"
Circle.AnchorPoint = Vector2.new(0.5, 0.5)
Circle.BackgroundTransparency = 1
Circle.Size = UDim2.fromOffset(300, 300)
Circle.Parent = GUI

local Round = Instance.new("UICorner")
Round.CornerRadius = UDim.new(1, 0)
Round.Parent = Circle

local Border = Instance.new("UIStroke")
Border.Color = Color3.fromRGB(255, 50, 50)
Border.Thickness = 2
Border.Parent = Circle

-- Panel
local Panel = Instance.new("Frame")
Panel.Size = UDim2.fromOffset(190, 145)
Panel.Position = UDim2.new(0, 15, 0.35, 0)
Panel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
Panel.Parent = GUI

Instance.new("UICorner", Panel)

local function Button(name, title, pos, size)
    local B = Instance.new("TextButton")
    B.Name = name
    B.Text = title
    B.Position = pos
    B.Size = size
    B.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    B.TextColor3 = Color3.new(1, 1, 1)
    B.TextSize = 14
    B.Parent = Panel

    Instance.new("UICorner", B)
    return B
end

local Toggle = Button(
    "Toggle",
    "SYSTEM: ON",
    UDim2.fromOffset(10, 10),
    UDim2.new(1, -20, 0, 35)
)

local Minus = Button(
    "Minus",
    "- FOV",
    UDim2.fromOffset(10, 55),
    UDim2.fromOffset(75, 30)
)

local Plus = Button(
    "Plus",
    "+ FOV",
    UDim2.fromOffset(105, 55),
    UDim2.fromOffset(75, 30)
)

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -20, 0, 35)
Status.Position = UDim2.fromOffset(10, 100)
Status.BackgroundTransparency = 1
Status.TextColor3 = Color3.new(1, 1, 1)
Status.Text = "Target: None"
Status.TextSize = 13
Status.Parent = Panel

-- Head Marker
local Marker = Instance.new("BillboardGui")
Marker.Name = "HeadMarker"
Marker.Size = UDim2.fromOffset(65, 65)
Marker.AlwaysOnTop = true
Marker.Enabled = false
Marker.Parent = GUI

local MarkerText = Instance.new("TextLabel")
MarkerText.Size = UDim2.fromScale(1, 1)
MarkerText.BackgroundTransparency = 1
MarkerText.Text = "✛"
MarkerText.TextColor3 = Color3.fromRGB(255, 40, 40)
MarkerText.TextStrokeTransparency = 0
MarkerText.TextScaled = true
MarkerText.Parent = Marker

-- Clear Target
local function ClearTarget()
    CurrentTarget = nil
    Marker.Enabled = false

    if CurrentHighlight then
        CurrentHighlight:Destroy()
        CurrentHighlight = nil
    end
end

-- Select Target
local function SelectTarget(Player)
    if CurrentTarget == Player then
        return
    end

    ClearTarget()
    CurrentTarget = Player

    local Character = Player.Character
    if not Character then return end

    local Head = Character:FindFirstChild("Head")
    if not Head then return end

    Marker.Adornee = Head
    Marker.Enabled = true

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "KarrarTargetHighlight"
    Highlight.Adornee = Character
    Highlight.FillColor = Color3.fromRGB(255, 40, 40)
    Highlight.OutlineColor = Color3.new(1, 1, 1)
    Highlight.FillTransparency = 0.8
    Highlight.Parent = GUI

    CurrentHighlight = Highlight
end

-- FOV Controls
local function UpdateFOV()
    Circle.Size = UDim2.fromOffset(FOVRadius * 2, FOVRadius * 2)
end

Minus.Activated:Connect(function()
    FOVRadius = math.max(50, FOVRadius - 25)
    UpdateFOV()
end)

Plus.Activated:Connect(function()
    FOVRadius = math.min(400, FOVRadius + 25)
    UpdateFOV()
end)

Toggle.Activated:Connect(function()
    Enabled = not Enabled
    Toggle.Text = Enabled and "SYSTEM: ON" or "SYSTEM: OFF"
    Circle.Visible = Enabled

    if not Enabled then
        ClearTarget()
        Status.Text = "Target: Disabled"
    end
end)

-- Main Tracking Loop
RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera

    local Viewport = Camera.ViewportSize
    local Center = Vector2.new(
        Viewport.X / 2,
        Viewport.Y / 2
    )

    Circle.Position = UDim2.fromOffset(Center.X, Center.Y)

    if not Enabled then return end

    local BestPlayer = nil
    local BestDistance = FOVRadius

    -- Keep current target if still valid
    if CurrentTarget then
        local Character = CurrentTarget.Character
        local Head = Character and Character:FindFirstChild("Head")

        if Head then
            local Position, Visible =
                Camera:WorldToViewportPoint(Head.Position)

            local Distance = (
                Vector2.new(Position.X, Position.Y) - Center
            ).Magnitude

            if Visible and Position.Z > 0 and Distance <= FOVRadius then
                BestPlayer = CurrentTarget
            end
        end
    end

    -- Find nearest target if needed
    if not BestPlayer then
        for _, Player in ipairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer then
                local Character = Player.Character
                local Head = Character and Character:FindFirstChild("Head")
                local Humanoid = Character and
                    Character:FindFirstChildOfClass("Humanoid")

                if Head and Humanoid and Humanoid.Health > 0 then
                    local Position, Visible =
                        Camera:WorldToViewportPoint(Head.Position)

                    if Visible and Position.Z > 0 then
                        local Distance = (
                            Vector2.new(Position.X, Position.Y) - Center
                        ).Magnitude

                        if Distance <= BestDistance then
                            BestDistance = Distance
                            BestPlayer = Player
                        end
                    end
                end
            end
        end
    end

    if BestPlayer then
        SelectTarget(BestPlayer)
        Status.Text = "Target: " .. BestPlayer.Name
    else
        ClearTarget()
        Status.Text = "Target: None"
    end
end)

Players.PlayerRemoving:Connect(function(Player)
    if Player == CurrentTarget then
        ClearTarget()
    end
end)

UpdateFOV()

print("Karrar Head Tracker V2 Loaded")
