-- ============================================
-- 🎯 تتبع الرأس الثابت فقط (Head Tracking Only)
-- ============================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- ═══════════════════════════════════════════
-- ⚙️ الإعدادات
-- ═══════════════════════════════════════════
local CONFIG = {
    FOV_RADIUS = 150,          -- نطاق البحث على الشاشة (بكسل)
    AIM_SMOOTHNESS = 0.35,     -- نعومة الانتقال (0.1 سريع - 0.5 بطيء)
    STICKINESS = 0.85,         -- ثبات على الهدف الحالي
    MAX_DISTANCE = 500,        -- أقصى مسافة (studs)
    ACTIVATION_KEY = Enum.UserInputType.MouseButton2, -- زر التصويب
    HEAD_OFFSET = Vector3.new(0, 0, 0),
}

-- ═══════════════════════════════════════════
-- 📦 المتغيرات
-- ═══════════════════════════════════════════
local currentTarget = nil
local isAiming = false

-- ═══════════════════════════════════════════
-- 🛠️ دوال مساعدة
-- ═══════════════════════════════════════════

local function HasLineOfSight(targetHead)
    local origin = Camera.CFrame.Position
    local direction = targetHead.Position - origin
    local distance = direction.Magnitude

    if distance > CONFIG.MAX_DISTANCE then
        return false, distance
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LocalPlayer.Character,
        Camera
    }

    local result = workspace:Raycast(origin, direction, params)
    if not result then return true, distance end
    if result.Instance and result.Instance:IsDescendantOf(targetHead.Parent) then
        return true, distance
    end
    return false, distance
end

local function GetScreenDistance(targetHead)
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
    if not onScreen then return math.huge end
    local mousePos = UserInputService:GetMouseLocation()
    return (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
        return false
    end
    return true
end

local function IsValidTarget(player)
    if not IsEnemy(player) then return false end
    local char = player.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    return true, head
end

-- ═══════════════════════════════════════════
-- 🎯 إيجاد أفضل هدف
-- ═══════════════════════════════════════════
local function FindBestTarget()
    local bestTarget = nil
    local bestScore = math.huge

    -- الثبات على الهدف الحالي
    if currentTarget then
        local valid, head = IsValidTarget(currentTarget)
        if valid then
            local screenDist = GetScreenDistance(head)
            local hasLOS = HasLineOfSight(head)
            if hasLOS and screenDist < CONFIG.FOV_RADIUS then
                bestTarget = currentTarget
                bestScore = screenDist * (1 - CONFIG.STICKINESS)
            end
        else
            currentTarget = nil
        end
    end

    -- البحث عن هدف جديد
    for _, player in pairs(Players:GetPlayers()) do
        if player == currentTarget then continue end
        local valid, head = IsValidTarget(player)
        if not valid then continue end
        local screenDist = GetScreenDistance(head)
        if screenDist > CONFIG.FOV_RADIUS then continue end
        local hasLOS, worldDist = HasLineOfSight(head)
        if not hasLOS then continue end
        local score = screenDist + (worldDist * 0.05)
        if score < bestScore then
            bestScore = score
            bestTarget = player
        end
    end

    currentTarget = bestTarget
    return currentTarget
end

-- ═══════════════════════════════════════════
-- 🎮 التحكم
-- ═══════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == CONFIG.ACTIVATION_KEY then
        isAiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == CONFIG.ACTIVATION_KEY then
        isAiming = false
        currentTarget = nil
    end
end)

-- ═══════════════════════════════════════════
-- 🔄 الحلقة الرئيسية — تتبع الرأس فقط
-- ═══════════════════════════════════════════
RunService.RenderStepped:Connect(function(deltaTime)
    if not isAiming then return end
    if not LocalPlayer.Character then return end

    local target = FindBestTarget()
    if not target then return end

    local targetHead = target.Character and target.Character:FindFirstChild("Head")
    if not targetHead then return end

    local targetPosition = targetHead.Position + CONFIG.HEAD_OFFSET
    local cameraPos = Camera.CFrame.Position

    -- ✅ تتبع ثابت مباشر — بدون تنبؤ، بدون velocity، بدون أي تعديل
    local goalCFrame = CFrame.lookAt(cameraPos, targetPosition)
    local smoothFactor = 1 - math.pow(1 - CONFIG.AIM_SMOOTHNESS, deltaTime * 60)

    Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, smoothFactor)
end)
