-- 🖱️ نظام السحب (محسّن للمس)
-- ═══════════════════════════════════════════
local function MakeDraggable(handle, targetFrame, onClick)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local pressStart = nil
    local pressPos = nil
    local moved = false
    local THRESHOLD = CONFIG.DRAG_THRESHOLD

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            pressStart = tick()
            pressPos = input.Position
            moved = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if pressPos and (input.Position - pressPos).Magnitude > THRESHOLD then
            moved = true
        end
        local delta = input.Position - dragStart
        targetFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = false
        if onClick and not moved and pressStart and (tick() - pressStart) < 0.4 then
            onClick()
        end
        pressStart = nil
        pressPos = nil
        moved = false
    end)
end

